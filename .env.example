# El servidor escucha solo en loopback por defecto. Mantén este valor detrás de Nginx/Caddy.
HOST=127.0.0.1
PORT=4173
NODE_ENV=production

# Origen público exacto, sin slash final. Es obligatorio en producción.
SITE_ORIGIN=https://eventos-ejemplo.com

# Resend: nunca expongas estos valores en main.js o en el HTML.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=ÉLITE Event's Iquitos <eventos@tu-dominio-verificado.com>
CONTACT_TO=contacto@tu-dominio.com

# Actívalo únicamente si el servidor está detrás de un proxy propio y confiable.
TRUST_PROXY=false

# Rate limit del formulario.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
